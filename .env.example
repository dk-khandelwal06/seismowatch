# SeismoWatch Environment Configuration
# Copy this file to .env.local for local development.

# PostgreSQL Connection String (Vercel Postgres, Neon, Supabase, or standard local PostgreSQL)
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
# If unconfigured, the application gracefully flags database persistence as BLOCKED.
DATABASE_URL=postgresql://postgres:password@localhost:5432/seismowatch

# Ingestion Secret Token (protects POST /api/ingestion/refresh from unauthorized triggers)
INGESTION_SECRET_TOKEN=change_this_to_a_secure_random_token

# Node Environment
NODE_ENV=development
